#!/usr/bin/env bash
# sysup — one routine for "update everything" (toolchain-plan 06, agreed 2026-09-01)
#
#   sysup            full cycle: paru -Syu -> mise (cache clear + upgrade, Rust excluded) -> canonical Pi checkout pull + native package update -> verify
#   sysup paru       only the system/AUR upgrade (--noconfirm, sudo)
#   sysup mise       only mise: cache clear + mise upgrade --exclude rust (coding agents excluded too)
#   sysup agents     update and verify Claude Code, Codex, OpenCode, and Copilot together
#   sysup rust       only Rust: mise upgrade rust (opt-in; routine updates leave Rust alone)
#   sysup pi         only the canonical Pi checkout pull and native package update
#   sysup status     read-only: pending updates and current versions
#   sysup verify     tool verification + restart reminders
#
# Policy: status-first manual use; no cron/automation; never a partial pacman
# upgrade (paru -Syu --noconfirm is the only paru invocation this script makes); no
# `--bump` (global config tracks `latest`); stop on first failure.
# Rust is the rolling-latest exception: mise owns the nightly toolchain
# (`mise install rust` provisions it), but routine mise upgrades exclude Rust.
# The coding-agent group is also opt-in; run `sysup agents` to update it.
# Run `sysup rust` explicitly to upgrade the compiler.
set -euo pipefail

# mise has no native groups. Keep this list authoritative for the opt-in
# coding-agent update set and for its default-upgrade exclusions. Use the exact
# global config keys: mise upgrade and --exclude do not resolve registry short
# names (claude, codex, ...) to these aqua: entries.
readonly CODING_AGENT_TOOLS=(
  aqua:anthropics/claude-code
  aqua:openai/codex
  aqua:anomalyco/opencode
  aqua:github/copilot-cli
)

say()  { printf '\n== %s ==\n' "$*"; }
die()  { printf '\nERROR: %s\n' "$*" >&2; exit 1; }

versions_before() {
  printf 'pi=%s\n' "$(pi --version 2>/dev/null | tr '\n' ' ')"
  printf 'herdr=%s\n' "$(herdr --version 2>/dev/null | tr '\n' ' ')"
  printf 'bun=%s\n' "$(bun --version 2>/dev/null)"
  printf 'rust=%s\n' "$(rustc --version 2>/dev/null)"
}

UPGRADED_PI=""
UPGRADED_HERDR=""
UPGRADED_BUN=""

cmd_paru() {
  command -v paru >/dev/null || die "paru not found"
  say "System + AUR upgrade (paru -Syu --noconfirm)"
  paru -Syu --noconfirm
}

cmd_mise() {
  command -v mise >/dev/null || die "mise not found"
  say "Mise: clearing cache (github backend batches releases; required before upgrade)"
  mise cache clear
  local upgrade_args=(upgrade --exclude rust)
  local tool
  for tool in "${CODING_AGENT_TOOLS[@]}"; do
    upgrade_args+=(--exclude "$tool")
  done
  say "Mise: upgrading normal tools (Rust and coding agents are opt-in)"
  mise "${upgrade_args[@]}"
}

cmd_agents() {
  command -v mise >/dev/null || die "mise not found"
  say "Mise: clearing cache before coding-agent group upgrade"
  mise cache clear
  say "Mise: upgrading coding-agent group (Claude Code, Codex, OpenCode, Copilot)"
  mise upgrade "${CODING_AGENT_TOOLS[@]}"
  cmd_verify_agents
}

cmd_rust() {
  command -v mise >/dev/null || die "mise not found"
  say "Mise: upgrading Rust only (opt-in compiler upgrade)"
  mise upgrade rust
}

pi_layout_ok() {
  local repo="$1"
  [[ -d "$repo/agent" && -d "$repo/agent/extensions" && -d "$repo/agent/skills" ]]
}

cmd_pi() {
  command -v git >/dev/null || die "git not found"
  command -v pi >/dev/null || die "pi not found"
  # Canonical checkout only: never route the repository through the legacy
  # PI_CODING_AGENT_DIR variable, and never follow a symlinked ~/.pi.
  local pi_repo="$HOME/.pi"
  [[ ! -L "$pi_repo" ]] \
    || die "Pi checkout must be a real directory, not a symlink: $pi_repo"
  local root toplevel origin
  root=$(cd "$pi_repo" 2>/dev/null && pwd -P) || die "canonical Pi checkout not found at $pi_repo"
  toplevel=$(git -C "$pi_repo" rev-parse --show-toplevel 2>/dev/null) \
    || die "not a git checkout: $pi_repo"
  [[ "$toplevel" == "$root" ]] || die "Pi checkout root is $toplevel, expected $pi_repo"
  origin=$(git -C "$pi_repo" remote get-url origin 2>/dev/null) \
    || die "no origin in $pi_repo"
  [[ "$origin" == "git@github.com:Algorant/.pi.git" ]] \
    || die "unexpected Pi origin: $origin (expected git@github.com:Algorant/.pi.git)"
  pi_layout_ok "$pi_repo" || die "native Pi layout missing under $pi_repo/agent"
  say "Pi checkout update (git -C $pi_repo pull --ff-only)"
  git -C "$pi_repo" pull --ff-only || die "Pi checkout update failed at $pi_repo"
  pi_layout_ok "$pi_repo" || die "native Pi layout missing after update in $pi_repo"
  say "Pi package update (pi update --extensions)"
  pi update --extensions
}

cmd_status() {
  say "Pending updates"
  echo "-- paru (system + AUR):"
  paru -Qu 2>/dev/null || echo "   (paru -Qu unavailable or nothing pending)"
  echo
  echo "-- mise (normal tools; Rust and coding agents are opt-in):"
  mise outdated 2>/dev/null || echo "   (no outdated tools)"
  echo "   (Coding agents are excluded by default: sysup agents updates and verifies Claude Code, Codex, OpenCode, and Copilot)"
  echo "   (Rust upgrades are opt-in: sysup rust runs mise upgrade rust)"
  echo
  echo "-- current versions:"
  mise current
  echo
  echo "AUR packages installed (paru -Qm count): $(paru -Qm 2>/dev/null | wc -l)"
}

cmd_verify_agents() {
  local local_status=0
  local passed=0 total=0
  say "Coding-agent verification"
  v_agent() {
    local description="$1"
    shift
    total=$((total + 1))
    if "$@" >/dev/null 2>&1; then
      echo "  PASS  $description"
      passed=$((passed + 1))
    else
      echo "  FAIL  $description"
      local_status=1
    fi
  }
  v_agent "Claude Code" claude --version
  v_agent "Codex" codex --version
  v_agent "OpenCode" opencode --version
  v_agent "Copilot" copilot --version
  echo "Coding agents: $passed/${#CODING_AGENT_TOOLS[@]} passed."
  return "$local_status"
}

cmd_verify() {
  local local_status=0
  say "Tool verification"
  passed=0; total=0
  v() { local description="$1"; shift; total=$((total + 1)); if "$@" >/dev/null 2>&1; then echo "  PASS  $description"; passed=$((passed + 1)); else echo "  FAIL  $description"; local_status=1; fi; }
  v "rustc (installed toolchain runs)" rustc --version
  v "zsh-patina" zsh-patina --version
  v "xurl" xurl --version
  v "secretspec" secretspec --version
  v "pass-cli" pass-cli --version
  v "fnox" fnox --version
  v "obscura" obscura --version
  v "ketch doctor" ketch doctor
  v "croc" croc --version
  v "flyctl" flyctl version
  v "playwright-cli" playwright-cli --version
  v "Claude Code" claude --version
  v "Codex" codex --version
  v "OpenCode" opencode --version
  v "Copilot" copilot --version
  # Binaries the Pi extensions invoke directly.
  v "bun" bun --version
  v "herdr" herdr --version
  v "tandem" tandem --version
  v "worktrunk" wt --version
  echo "Tools: $passed/$total passed."
  [[ -n "$UPGRADED_PI" ]]    && echo "> pi changed ($UPGRADED_PI) — restart Pi to run the new binary"
  [[ -n "$UPGRADED_HERDR" ]] && echo "> herdr changed ($UPGRADED_HERDR) — restart herdr (your terminal host)"
  [[ -n "$UPGRADED_BUN" ]]   && echo "> bun changed ($UPGRADED_BUN) — restart dependent daemons (sideshow)"
  return "$local_status"
}

cmd_full() {
  local before
  before=$(versions_before)
  cmd_paru
  cmd_mise
  local after
  after=$(versions_before)
  # Only report changed components the user must act on.
  [[ "$(printf '%s' "$before" | grep '^pi=')" != "$(printf '%s' "$after" | grep '^pi=')" ]] && UPGRADED_PI="$(printf '%s' "$after" | grep '^pi=')"
  [[ "$(printf '%s' "$before" | grep '^herdr=')" != "$(printf '%s' "$after" | grep '^herdr=')" ]] && UPGRADED_HERDR="$(printf '%s' "$after" | grep '^herdr=')"
  [[ "$(printf '%s' "$before" | grep '^bun=')" != "$(printf '%s' "$after" | grep '^bun=')" ]] && UPGRADED_BUN="$(printf '%s' "$after" | grep '^bun=')"
  cmd_pi
  cmd_verify
}

usage() {
  awk 'NR == 1 { next } /^# ?/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}

case "${1:-full}" in
  full|"")   cmd_full ;;
  paru)      cmd_paru ;;
  mise)      cmd_mise ;;
  rust)      cmd_rust ;;
  agents)    cmd_agents ;;
  pi)        cmd_pi ;;
  status)    cmd_status ;;
  verify)    cmd_verify ;;
  help|-h|--help) usage ;;
  *) die "unknown subcommand: $1 (see sysup help)" ;;
esac