// ~/.config/fastfetch/config.jsonc
// See https://github.com/fastfetch-cli/fastfetch/wiki/Configuration for more details
// See *.jsonc in https://github.com/fastfetch-cli/fastfetch/tree/dev/presets/examples for more examples
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty",
      "source": "$(ls ~/.config/fastfetch/icons/arch-verdigris/*.png | shuf -n 1)",
      "width": 18,
      "height": 8,
      "padding": {
        "top": 1,
        "left": 1
      }
    },
    "display": {
        "separator": "▐ " ,
        "color": "#e6bf86",
        "size": {
          "ndigits": 0
        }
    },
    "modules": [
        "title", 
        "separator",   
        {
            "type": "os",
            "key": " ", // Just get your distro's logo off nerdfonts.com
            "keyColor": "#8ec07c"
        },
        {
            "type": "uptime",
            "key": "󰥔 ",
            "keyColor": "#83a598"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#e6bf86"
        },
        "de",
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#689d6a"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#e6bf86"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "#458588" // teal
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "#8ec07c", // fern
            "folders": "/"
        },
        "break",
        {
            // Exact seven-dot Verdigris row; keep this independent of the terminal ANSI palette.
            // ashbronze, vellum, teal, patina, aqua, ochre, fern
            "type": "command",
            "key": " ",
            "text": "printf '\\033[38;2;102;92;84m●\\033[0m \\033[38;2;235;219;178m●\\033[0m \\033[38;2;69;133;136m●\\033[0m \\033[38;2;104;157;106m●\\033[0m \\033[38;2;131;165;152m●\\033[0m \\033[38;2;230;191;134m●\\033[0m \\033[38;2;142;192;124m●\\033[0m'"
        }
    ]
}
